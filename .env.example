# Copy to .env; all values here are local defaults, not secrets.
JOBFIT_DATASET_PATH=dataset/jobs_synthetic_250.jsonl
JOBFIT_DATASET_ID=synthetic_india_ai_sw_v2
JOBFIT_ARTIFACTS_DIR=artifacts
JOBFIT_CORPUS_SUBSET=all
JOBFIT_RECENCY_FILTER_ENABLED=false
JOBFIT_REFERENCE_DATE=2026-11-18
JOBFIT_RECENCY_WINDOW_DAYS=90
JOBFIT_EMBEDDING_MODEL=BAAI/bge-m3
JOBFIT_EMBEDDING_DIMENSION=1024
JOBFIT_NORMALIZE_EMBEDDINGS=true
JOBFIT_VECTOR_DISTANCE=cosine
JOBFIT_EMBEDDING_DEVICE=cpu
JOBFIT_EMBEDDING_BATCH_SIZE=4
JOBFIT_QDRANT_URL=http://127.0.0.1:6333
JOBFIT_QDRANT_COLLECTION=jobfit_synthetic_india_ai_sw_v2
JOBFIT_LLM_PROVIDER=openai_compatible
QWEN_MODEL=Qwen/Qwen3.8-27B
# Replace with your remote OpenAI-compatible endpoint and credentials.
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=
QWEN_JSON_MODE=true
QWEN_MAX_TOKENS=2048
QWEN_MAX_MODEL_LEN=32768
QWEN_ENABLE_THINKING=false
QWEN_TEMPERATURE=0
QWEN_TOP_P=1
QWEN_TIMEOUT=120
JOBFIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
JOBFIT_MAX_RECOMMENDATIONS=5
JOBFIT_MAX_UPLOAD_MB=5
JOBFIT_MAX_RESUME_PAGES=10
JOBFIT_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
JOBFIT_EMBEDDING_CACHE_DIR=artifacts/model_cache
JOBFIT_EMBEDDING_CPU_THREADS=4
JOBFIT_QDRANT_MODE=local
JOBFIT_QDRANT_PATH=artifacts/qdrant
JOBFIT_CANDIDATE_COUNT=30
# Dense remains the baseline; choose bm25 or hybrid to compare.
JOBFIT_RETRIEVAL_MODE=dense
JOBFIT_BM25_CANDIDATE_COUNT=30
JOBFIT_BM25_K1=1.5
JOBFIT_BM25_B=0.75
JOBFIT_RRF_CONSTANT=60
# Optional local cross-encoder: download with python -m app.cli.download_models reranker.
JOBFIT_RERANK_ENABLED=false
JOBFIT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
JOBFIT_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
JOBFIT_RERANK_CACHE_DIR=artifacts/reranker_cache
JOBFIT_RERANK_DEVICE=cpu
JOBFIT_RERANK_BATCH_SIZE=2
JOBFIT_RERANK_MAX_TOKENS=512
JOBFIT_RERANK_CPU_THREADS=4
JOBFIT_MIN_COSINE_SIMILARITY=0.55
JOBFIT_MIN_REQUIRED_COVERAGE=50
JOBFIT_MIN_EVIDENCED_REQUIRED=2
JOBFIT_GENERATION_ATTEMPTS=2
JOBFIT_API_TIMEOUT_SECONDS=120
JOBFIT_API_SESSION_TTL_SECONDS=1800
JOBFIT_API_MAX_SESSIONS=20
